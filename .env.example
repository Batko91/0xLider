# Скопируйте в .env и заполните — Bun подхватывает .env автоматически.

# OLX Partner API v2: ключи приложения
OLX_CLIENT_ID=
OLX_CLIENT_SECRET=
# OLX_BASE_URL=https://www.olx.uz
# Если redirect_uri приложения OLX не http://localhost:3000/olx/callback
# OLX_REDIRECT_URI=

# Данные объявлений
OLX_CONTACT_NAME=
OLX_CONTACT_PHONE=
# id города и района OLX: bun run olx cities Ташкент / bun run olx districts <id>
OLX_CITY_ID=
OLX_DISTRICT_ID=

# WooCommerce: WooCommerce → Настройки → Дополнительно → REST API (права Read)
WC_URL=https://example.uz
WC_CONSUMER_KEY=ck_
WC_CONSUMER_SECRET=cs_
